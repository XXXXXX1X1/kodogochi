# Скопируйте в .env (или app.env на сервере) и заполните. Файл с секретами в git не кладите.
BOT_TOKEN=                       # токен от @BotFather
PUBLIC_URL=https://kodogochi.example.ru
DEFAULT_TZ=Asia/Novosibirsk
TIME_SCALE=1                     # 1 — обычный режим; 1440 — демо: игровые сутки за 1 минуту
ANTHROPIC_KEY_FILE=              # путь к файлу с ключом Claude; пусто — только шаблонные реплики
LLM_MODEL=claude-opus-5-5
GITHUB_TOKEN_FILE=               # необязательно: токен GitHub только на чтение (нужен для приватных репозиториев)
